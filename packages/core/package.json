{
  "name": "dsh-whale-core",
  "version": "0.0.1",
  "type": "module",
  "description": "插件共享工具与类型。不注册工具，只提供函数。",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": ["lib"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\""
  }
}
